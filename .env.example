# Jurista Configuration
# Replace with your Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Indian Kanoon API key — optional but recommended.
# When set, legal_db.py queries the Indian Kanoon API for live case law and
# statute search results (primary source). If absent, unreachable, or returns
# no results, the system silently falls back to the curated hardcoded BM25
# statutory database. Obtain a key at https://api.indiankanoon.org/
INDIANKANOON_API_KEY=

# Server settings
PORT=8000
HOST=127.0.0.1
